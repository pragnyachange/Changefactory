let addLanguageToObjectInfos = function(objectInfos, lang) {

    switch(objectInfos.type) {
        case "Project":
			switch(lang) {
				case "de":
					objectInfos.typeName = "Projekt";
					break;
				case "fr":
					objectInfos.typeName = "Projet";
					break;
				case "it":
					objectInfos.typeName = "Progetto";
					break;
				default:
					objectInfos.typeName = "Project";
			}
			break;
        case "Todo":
			switch(lang) {
				case "de":
					objectInfos.typeName = "Todo";
					break;
				case "fr":
					objectInfos.typeName = "Todo";
					break;
				case "it":
					objectInfos.typeName = "Todo";
					break;
				default:
					objectInfos.typeName = "Todo";
			}
			break;
        case "Meeting":
			switch(lang) {
				case "de":
					objectInfos.typeName = "Meeting";
					break;
				case "fr":
					objectInfos.typeName = "Séance";
					break;
				case "it":
					objectInfos.typeName = "Inconto";
					break;
				default:
					objectInfos.typeName = "Meeting";
			}
			break;
        case "FieldOfAction":
			switch(lang) {
				case "de":
					objectInfos.typeName = "Handlungsfeld";
					break;
				case "fr":
					objectInfos.typeName = "Champ d'action";
					break;
				case "it":
					objectInfos.typeName = "Campo d'azione";
					break;
				default:
					objectInfos.typeName = "Field of action";
			}
			break;
        case "Scenario": // Consider relations to parent project
			switch(lang) {
				case "de":
					objectInfos.typeName = "Szenario";
					objectInfos.parent.typeName = "Projekt";
					break;
				case "fr":
					objectInfos.typeName = "Scénario";
					objectInfos.parent.typeName = "Projet";
					break;
				case "it":
					objectInfos.typeName = "Scenario";
					objectInfos.parent.typeName = "Progetto";
					break;
				default:
					objectInfos.typeName = "Scenario";
					objectInfos.parent.typeName = "Project";
			}
            break;
        case "ProjectContribution": // Consider relations to parent project
			switch(lang) {
				case "de":
					objectInfos.typeName = "Projektbeitrag";
					objectInfos.parent.typeName = "Projekt";
					break;
				case "fr":
					objectInfos.typeName = "Contribution au projet";
					objectInfos.parent.typeName = "Projet";
					break;
				case "it":
					objectInfos.typeName = "Contributo al progetto";
					objectInfos.parent.typeName = "Progetto";
					break;
				default:
					objectInfos.typeName = "Project contribution";
					objectInfos.parent.typeName = "Project";
			}
            break;
        default: // Assume project or portfolio report type
			let reportType = null;
			switch (objectInfos.parent.type) {
				case "ProjectPortfolio": 
					// TODO: Need a request that allows to specify the language!
					reportType = Pqf.pm.getProjectPortfolioReportType(objectInfos.type);
					switch(lang) {
						case "de":
							objectInfos.typeName = reportType.name;
							objectInfos.parent.typeName = "Projektportfolio";
							break;
						case "fr":
							objectInfos.typeName = reportType.name;
							objectInfos.parent.typeName = "Portefeuille de projet";
							break;
						case "it":
							objectInfos.typeName = reportType.name;
							objectInfos.parent.typeName = "Portfolio de progetto";
							break;
						default:
							objectInfos.typeName = reportType.name;
							objectInfos.parent.typeName = "Project portfolio";
					}
					break;
				case "Project":
					// TODO: Need a request that allows to specify the language!
					reportType = Pqf.pm.getProjectReportType(objectInfos.type);
					switch(lang) {
						case "de":
							objectInfos.typeName = reportType.name;
							objectInfos.parent.typeName = "Projekt";
							break;
						case "fr":
							objectInfos.typeName = reportType.name;
							objectInfos.parent.typeName = "Projet";
							break;
						case "it":
							objectInfos.typeName = reportType.name;
							objectInfos.parent.typeName = "Progetto";
							break;
						default:
							objectInfos.typeName = reportType.name;
							objectInfos.parent.typeName = "Project";
					}
					break;				
			}
    }

	return objectInfos;
}

let getIntro = function(receiverInfos, lang) {
	let intro = "";
    switch(lang) {
        case "de":
            intro += "<p>" + (receiverInfos.resourceName ? "Hallo " + receiverInfos.resourceName + "!" : (receiverInfos.name ? "Hallo " + receiverInfos.name + "!" : "Hallo!")) + "</p>";
			break;
        case "fr":
            intro += "<p>" + (receiverInfos.resourceName ? "Salut " + receiverInfos.resourceName + "!" : (receiverInfos.name ? "Salut " + receiverInfos.name + "!" : "Salut!")) + "</p>";
			break;
        case "it":
            intro += "<p>" + (receiverInfos.resourceName ? "Ciao " + receiverInfos.resourceName + "!" : (receiverInfos.name ? "Ciao " + receiverInfos.name + "!" : "Ciao!")) + "</p>";
			break;
        default:
            intro += "<p>" + (receiverInfos.resourceName ? "Hello " + receiverInfos.resourceName + "!" : (receiverInfos.name ? "Hello " + receiverInfos.name + "!" : "Hello!")) + "</p>";
    }
	return intro;
}

let getBody = function(objectInfos, lang) {
	let body = "<ul>";
	let currentStateLabel = getCurrentStateLabel(lang);
	let remarkLabel = getRemarkLabel(lang);
	let noRemarkText = getNoRemarkText(lang);

	body += "<li><b>" + objectInfos.typeName + "</b>:  <a href='" + objectInfos.url + "'>" + objectInfos.name + "</a></li>"
	body += "<li><b>" + currentStateLabel + "</b>: " + objectInfos.stateNow.name + "</li>";
	if (objectInfos.parent) {
		body += "<li><b>" + objectInfos.parent.typeName + "</b>: <a href='" + objectInfos.parent.url + "'>" + objectInfos.parent.name + "</a></li>"
	}
	body += "<li><b>" + remarkLabel + "</b>: " + (objectInfos.remark ? objectInfos.remark : noRemarkText) + "</li>";
	body += "</ul>";
	
	return body;
}

let getOutro = function(objectInfos, lang) {
	let outro = "";
	switch(lang) {
		case "de":
			outro += "<p>Mit diesem <a href=\"" + objectInfos.url + "\">Link</a> gelangst du direkt zum betreffenden Objekt. Bitte antworte nicht auf diese E-Mail.</p>";
			outro += "<p>PQFORCE Notifikationssystem</p>";
			break;
		case "fr":
			outro += "<p>Ce <a href=\"" + objectInfos.url + "\">lien</a> te mène directement à l'objet en question. Ne réponds pas à cet e-mail.</p>";
			outro += "<p>Système de notifications de PQFORCE</p>";
			break;
		case "it":
			outro += "<p>Questo <a href=\"" + objectInfos.url + "\">Link</a> vi porterà direttamente all'oggetto in questione. Non rispondere a questa e-mail.</p>";
			outro += "<p>Sistema di notifica PQFORCE</p>";
			break;
		default:
			outro += "<p>This <a href=\"" + objectInfos.url + "\">link</a> takes you directly to the corresponding object. Please do not reply to this email.</p>";
			outro += "<p>PQFORCE notification system</p>";
	}
	return outro;
}


// -----------------------------------------------------------------------------
// Main functionality
// -----------------------------------------------------------------------------

let objectState = getLastLifecycleStates(trigger.objectType, trigger.objectId);
let actorInfos = getActorInfos();
if (objectState.current) {
    if (actorInfos && actorInfos.email) blockedMail.add(actorInfos.email.toLowerCase());
    DEBUG ? console.log("LCY change: " + trigger.objectType + "|" + trigger.objectId + " : " + (objectState.last ? objectState.last.name : "*") + " -> " + objectState.current.name) : null;
		
	// Notify decision request?
	if (objectState.current.isDecision) {
		DEBUG ? console.log("Current state " + objectState.current.name + "|" + objectState.current.id + " is decision state.") : null;
		let objectInfos = getObjectInfos(trigger.objectType, trigger.objectId, objectState);
		let deciders = getDeciders(objectInfos, objectState.current.id);
		if (deciders && deciders.length) {
			DEBUG ? console.log("Notifying " + deciders.length + " users.") : null;
			for (let decider of deciders) {
				let lang = getLanguage(decider.email);
				DEBUG ? console.log("Notifiying " + decider.name + " (" + decider.email + ") about decision to be taken (lang = " + (lang || "en") + ").") : null;
				objectInfos = addLanguageToObjectInfos(objectInfos, lang);
				let message = createMailDecisionRequest(decider, actorInfos, objectInfos, lang);
				pqfLib.mail.sendNotification3([decider.email], message.subject, message.intro, message.body, message.outro, false, MAIL_SKIN, true);
			}
			// Save deciders and actor in store
			let toStore = {
				"actorInfos": actorInfos,
				"deciders": deciders
			};
			store.save(trigger.objectId, toStore);
		} else {
			DEBUG ? console.log("No deciders found.") : null;
		}
	}
	
	// Notify decision taken
	if (objectState.last && objectState.last.isDecision) {
		let fromStore = store.load(trigger.objectId);
		if (fromStore) {
			DEBUG ? console.log("Object infos found in store") : null;
			let objectInfos = getObjectInfos(trigger.objectType, trigger.objectId, objectState);

			// Notify original requester
			let requesterInfos = fromStore.actorInfos;
			if (requesterInfos) {
				let lang = getLanguage(requesterInfos.email);
				DEBUG ? console.log("Notifiying the requester " + requesterInfos.resourceName + " (" + requesterInfos.name + ", " + requesterInfos.email + ") about decision taken (lang = " + (lang || "en") + ").") : null;
				objectInfos = addLanguageToObjectInfos(objectInfos, lang);
				let message = createMailDecisionTakenForRequester(requesterInfos, actorInfos, objectInfos, lang);
				pqfLib.mail.sendNotification3([requesterInfos.email], message.subject, message.intro, message.body, message.outro, false, MAIL_SKIN, true);
			}

			// Notify other deciders
			let deciders = fromStore.deciders;
			if (deciders) {
				deciders = deciders.filter(d => d.name != actorInfos.name);
				for (let decider of deciders) {
					let lang = getLanguage(decider.email);
					DEBUG ? console.log("Notifiying other decider " + decider.resourceName + " (" + decider.name + ", " + decider.email + ") about decision taken (lang = " + (lang || "en") + ").") : null;
					objectInfos = addLanguageToObjectInfos(objectInfos, lang);
					let message = createMailDecisionTakenForOtherDeciders(requesterInfos, decider, actorInfos, objectInfos, lang);
					pqfLib.mail.sendNotification3([decider.email], message.subject, message.intro, message.body, message.outro, false, MAIL_SKIN, true);
				}				
			}

			// Reset store for this object
			store.save(trigger.objectId, null);
		} else {
			DEBUG ? console.log("Decision taken for object " + trigger.objectType + "|" + trigger.objectId + ", but no infos found in store") : null;
		}
	}
	
} else {
    DEBUG ? console.log("LCY change: " + trigger.objectType + "|" + trigger.objectId + " : object may have been deleted") : null;
}