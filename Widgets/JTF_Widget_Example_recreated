// FUNCTIONS ###################################################################
/**
 * Set of function definitions that are specific to this widget.
 */

// recursively loads resources of an OU and optionally its sub-OUs, while filtering for duplicates. This is crucial for ensuring that the widget can display all relevant employees when the user opts to include sub-OUs, without showing the same employee multiple times if they belong to multiple OUs.
function _getResObjs(ouId, incl_subOUs) {
    // Load all child resource of this OU
    let resObjs = [];
    try {
        //gets everything under the OU so employees but also sub OUs and their employees, which is why we need to filter for the employee type later on
        resObjs = Pqf.res.getResourceChildren(ouId);
    } catch {
        // handle errors
        hints.push({
            "type": "warn",
            "label": "Resource Load Warning",
            "message": "Failed to load child-resources of OU with ID " + ouId
        })
    }
    if (!resObjs || resObjs.length === 0) {
        return [];
    }
    // If the user wants to consider sub OUs, load all resources of the OU and its children -> builds a tree traversal
    if (incl_subOUs) {
        resObjs.forEach(child => {
            resObjs = resObjs.concat(_getResObjs(child.id, incl_subOUs));
        });
    }
    // Filter duplicate resource enums
    resObjs = resObjs.filter((resObj, index, self) =>
        index === self.findIndex((r) => r.id === resObj.id)
    );
    
    return resObjs;
}

function _toEnum(obj) {
    if (!obj) {
        return null;
    }
    return {
        'type': obj.type,
        'id': obj.id,
        'name': obj.name,
        'description': obj.description,
        'iconRef': obj.iconRef,
        'color': obj.color
    };
}