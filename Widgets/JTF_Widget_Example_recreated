// load resources of the OU using _getResObjs
// reference.id is the current OU ID and filters ie HRM-RES-TYP-EMP ensures that only employees are included in the list. The resulting resource objects are then transformed into rows for the JTF, where the name column is formatted as an enum (to include icons and links) and the email column is extracted from the resource properties.
let resObjs = _getResObjs(reference.id, incl_subOUs).filter(resObj => resObj.type === "HRM-RES-TYP-EMP");
